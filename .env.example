# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to 
DATABASE_URL=
DATABASE_URL_POOLER=

# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=

# Add your OpenRouter API key
OPENROUTER_API_KEY=

# SELECT-only Postgres role for the AI assistant. Generate with
# `npm run setup:readonly`. This is what makes the assistant read-only at the
# database-grant level rather than by prompt instruction.
DATABASE_URL_READONLY=

# Optional model overrides. Must be OpenRouter chat model ids.
# ASSISTANT_MODEL_CHAT=anthropic/claude-haiku-4.5
# ASSISTANT_MODEL_EXPLAIN=anthropic/claude-sonnet-4.6
