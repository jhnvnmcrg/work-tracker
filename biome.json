{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**/*",
			".vscode/**/*",
			"index.html",
			"vite.config.ts",
			"drizzle.config.ts",
			"neon-vite-plugin.ts",
			"!src/routeTree.gen.ts",
			"!src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"correctness": {
						"useExhaustiveDependencies": "off"
					},
					"suspicious": {
						"noDocumentCookie": "off",
						"noArrayIndexKey": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/payroll/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"#/db/index.ts": "The payroll engine must stay pure — it takes plain data and returns plain data, so it is unit-testable without a database and so payslip snapshot replay works. Read from the database in src/server/payroll/load.ts instead.",
									"#/db/schema/index.ts": "Import domain types from #/lib/payroll/types.ts, not from the Drizzle schema. The engine must not depend on the database layer."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/ai/tools/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"#/db/index.ts": "AI tools must use the SELECT-only connection in #/lib/ai/db-readonly.ts. The assistant is read-only at the database-grant level, not by prompt instruction."
								}
							}
						}
					}
				}
			}
		}
	]
}
